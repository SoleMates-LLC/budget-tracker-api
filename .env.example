# ─────────────────────────────────────────────
#  Budget Tracker Backend — Environment Config
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budget_tracker
DB_USER=budget_user
DB_PASSWORD=your_strong_password_here
DB_SSL=false          # Set to true in production (Railway, Render, etc.)

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex_string
JWT_EXPIRES_IN=30d

# Apple Sign In
# Found in Apple Developer Portal → Certificates, Identifiers & Profiles
APPLE_TEAM_ID=XXXXXXXXXX            # 10-character Team ID
APPLE_CLIENT_ID=com.yourapp.budget  # Your app's Bundle ID (Services ID for web)
APPLE_KEY_ID=XXXXXXXXXX             # 10-character Key ID
# Paste the contents of your AuthKey_XXXXXXXXXX.p8 file below (keep newlines as \n)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com
